        "store": {
            "0": "\u661f\u671f\u4e00\uff1a\u5718\u968a\u6703\u8b70\u5ef6\u9577\u4e8630\u5206\u9418\u3002\u9700\u8981\u5728\u661f\u671f\u4e94\u4e4b\u524d\u5b8c\u6210\u7b2c\u4e00\u5b63\u5ea6\u9810\u7b97\u5831\u544a\u3002IT\u66f4\u65b0\u4e86\u5b89\u5168\u898f\u5247\u2014\u8acb\u6539\u8b8a\u5bc6\u78bc\u3002\u8207 Jacob \u7684\u5ba2\u6236\u96fb\u8a71\u5ef6\u671f\u5230\u661f\u671f\u4e09\u3002",
            "1": "\u661f\u671f\u4e8c\uff1a\u7cfb\u7d71\u505c\u6a5f\u5f9e10:00 AM\u523012:00 PM\uff0c\u5f71\u97ff\u4e86\u5de5\u4f5c\u6d41\u7a0b\u3002\u4eba\u529b\u8cc7\u6e90\u90e8\u9580\u767c\u9001\u4e86\u66f4\u65b0\u7684\u798f\u5229\u5957\u9910\u2014\u8acb\u5728\u4e0b\u500b\u6708\u622a\u6b62\u65e5\u671f\u524d\u5be9\u95b1\u3002\u5411\u4f9b\u61c9\u5546\u767c\u9001\u4e86\u8ffd\u8e64\u90f5\u4ef6\uff0c\u7b49\u5f85\u56de\u61c9\u3002",
            "2": "\u661f\u671f\u4e09\uff1a\u5411\u9818\u5c0e\u5c64\u505a\u4e86\u7c21\u5831\uff0c\u6574\u9ad4\u4e0a\u5f88\u9806\u5229\uff0c\u4f46\u9700\u8981\u5728\u4e0b\u9031\u7684\u56de\u9867\u4e2d\u8abf\u6574\u5e7e\u500b\u5e7b\u71c8\u7247\u3002\u5ba2\u6236\u63d0\u6848\u8349\u6848\u5df2\u5c31\u7dd2\u2014\u8acb\u6cd5\u5f8b\u5be9\u6838\u3002\u9700\u8981\u62db\u52df\u65b0\u54e1\u5de5\u2014\u5b89\u6392\u4e00\u5c0d\u4e00\u6703\u8b70\u3002",
            "3": "\u661f\u671f\u56db\uff1a\u8ca1\u52d9\u90e8\u9580\u9700\u8981\u7bc0\u7701\u6210\u672c\u7684\u5efa\u8b70\u2014\u60f3\u51fa\u4e00\u4e9b\u9ede\u5b50\u3002\u5c08\u6848\u622a\u6b62\u65e5\u671f\u5373\u5c07\u5230\u4f86\u2014\u8207\u958b\u767c\u5718\u968a\u806f\u7e6b\u3002\u767c\u73fe\u4e0a\u500b\u6708\u92b7\u552e\u6578\u64da\u4e2d\u7684\u4e00\u500b\u932f\u8aa4\u3002",
            "4": "\u661f\u671f\u4e94\uff1a\u5b8c\u6210\u4e86\u6240\u6709\u5f85\u5be9\u6279\u7684\u5831\u544a\uff0c\u4f46\u4ecd\u5728\u7b49\u5f85\u6700\u7d42\u6279\u51c6\u3002\u8ddf\u9032\u4e86\u4f9b\u61c9\u5546\u2014\u5169\u500b\u56de\u61c9\u4e86\uff0c\u9084\u6709\u4e00\u500b\u5c1a\u672a\u56de\u61c9\u3002\u4e0b\u9031\u4e00\u6709\u57f9\u8a13\u6703\u8b70\u2014\u5468\u672b\u6e96\u5099\u6750\u6599\u3002"
        }
