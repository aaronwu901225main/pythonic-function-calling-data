{
    "memory": "\u6211\u500b\u4eba\u6295\u8cc7\u7d44\u5408\u7684\u7b56\u7565\u662f\u4ee5\u9577\u671f\u70ba\u5c0e\u5411\uff0c\u5e73\u8861\u9ad8\u98a8\u96aa\u6a5f\u6703\u8207\u7a69\u5b9a\u7684\u6536\u5165\u7522\u751f\u6295\u8cc7\uff0c\u6838\u5fc3\u90e8\u5206\u662f\u80a1\u7968\u548c\u79c1\u52df\u80a1\u6b0a\uff0c\u9084\u5305\u62ec\u6df7\u5408\u7684\u50b5\u5238\u3001\u4e0d\u52d5\u7522\u548c\u66ff\u4ee3\u8cc7\u7522\u3002\u6211\u7684\u76ee\u6a19\u4e0d\u662f\u50c5\u50c5\u7d2f\u7a4d\u8ca1\u5bcc\uff0c\u800c\u662f\u8cc7\u672c\u7684\u4fdd\u7559\u548c\u6230\u7565\u6027\u589e\u9577\u3002\u6838\u5fc3\u90e8\u5206\u662f\u80a1\u7968\u548c\u79c1\u52df\u80a1\u6b0a\uff0c\u9084\u5305\u62ec\u6df7\u5408\u7684\u50b5\u5238\u3001\u4e0d\u52d5\u7522\u548c\u66ff\u4ee3\u8cc7\u7522\u3002\u6211\u7684\u76ee\u6a19\u4e0d\u662f\u50c5\u50c5\u7d2f\u7a4d\u8ca1\u5bcc\uff0c\u800c\u662f\u8cc7\u672c\u7684\u4fdd\u7559\u548c\u6230\u7565\u6027\u589e\u9577\u3002\u6211\u500b\u4eba\u6295\u8cc7\u7d44\u5408\u7684\u7b56\u7565\u662f\u4ee5\u9577\u671f\u70ba\u5c0e\u5411\uff0c\u5e73\u8861\u9ad8\u98a8\u96aa\u6a5f\u6703\u8207\u7a69\u5b9a\u7684\u6536\u5165\u7522\u751f\u6295\u8cc7\u3002\u6838\u5fc3\u90e8\u5206\u662f\u80a1\u7968\u548c\u79c1\u52df\u80a1\u6b0a\uff0c\u9084\u5305\u62ec\u6df7\u5408\u7684\u50b5\u5238\u3001\u4e0d\u52d5\u7522\u548c\u66ff\u4ee3\u8cc7\u7522\u3002\u6211\u7684\u76ee\u6a19\u4e0d\u662f\u50c5\u50c5\u7d2f\u7a4d\u8ca1\u5bcc\uff0c\u800c\u662f\u8cc7\u672c\u7684\u4fdd\u7559\u548c\u6230\u7565\u6027\u589e\u9577\u3002"
